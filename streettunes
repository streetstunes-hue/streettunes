          <section className="max-w-4xl mx-auto px-4 py-8">
            <h1 className="text-3xl font-extrabold text-white uppercase tracking-tight mb-6">About {settings.businessName}</h1>
            <div className="bg-[#151C28] border border-gray-800 rounded-2xl p-6 md:p-8 space-y-6">
