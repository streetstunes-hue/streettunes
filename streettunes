                <h3 className="text-lg font-bold text-amber-400 uppercase tracking-wide mb-2">Our Mission & Identity</h3>
                <p className="text-gray-300 leading-relaxed text-sm md:text-base">{settings.aboutText}</p>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-gray-800">
