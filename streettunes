                  <h4 className="text-white font-bold text-sm mb-1">Quality & Sonic Clarity</h4>
                  <p className="text-gray-400 text-xs">Uncompromising signal flow, calibrated monitoring, and professional mastering chains.</p>
                </div>
                <div className="p-4 bg-gray-900/60 rounded-xl border border-gray-800">
                  <h4 className="text-white font-bold text-sm mb-1">Authentic Community Roots</h4>
                  <p className="text-gray-400 text-xs">Built to empower raw talent and connect creative artists directly with high-standard engineering.</p>
                </div>
              </div>
            </div>
          </section>
        )}

        {/* VIEW: CONTACT & ENQUIRY */}
        {activeTab === 'contact' && (
          <section className="max-w-5xl mx-auto px-4 py-8">
            <div className="mb-8">
              <h1 className="text-3xl font-extrabold text-white uppercase tracking-tight">Contact & Support</h1>
              <p className="text-gray-400 text-sm mt-1">Get in touch directly with our management and engineering team.</p>
            </div>

            <div className="grid grid-cols-1 md:grid-cols-5 gap-8">
              {/* Left Column: Direct channels */}
              <div className="md:col-span-2 space-y-6">
                <div className="bg-[#151C28] border border-gray-800 rounded-2xl p-6 space-y-4">
                  <h3 className="text-lg font-bold text-white mb-2">Direct Channels</h3>
                  
                  <a
                    href={getWhatsAppUrl()}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="flex items-center gap-3 p-3 rounded-xl bg-[#25D366]/10 border border-[#25D366]/30 text-white hover:bg-[#25D366]/20 transition"
                  >
                    <div className="w-10 h-10 rounded-lg bg-[#25D366] text-black flex items-center justify-center font-bold">
                      <MessageSquare size={20} />
                    </div>
                    <div>
                      <span className="text-xs text-[#25D366] font-bold block uppercase tracking-wider">Fastest Response</span>
                      <span className="text-sm font-semibold">Chat on WhatsApp</span>
                    </div>
                  </a>

                  <div className="p-3 rounded-xl bg-gray-900/50 border border-gray-800">
                    <span className="text-xs text-gray-500 uppercase block font-medium">Email Enquiries</span>
                    <span className="text-sm text-gray-200 font-mono">{settings.email}</span>
                  </div>

                  <div className="p-3 rounded-xl bg-gray-900/50 border border-gray-800">
                    <span className="text-xs text-gray-500 uppercase block font-medium">Headquarters</span>
                    <span className="text-sm text-gray-200">{settings.location}</span>
                  </div>
                </div>

                {/* Verified Social Media Profiles */}
                <div className="bg-[#151C28] border border-gray-800 rounded-2xl p-6">
                  <h4 className="text-sm font-bold text-white mb-4">Official Channels</h4>
                  <div className="space-y-2">
                    {settings.socials.instagram && (
                      <a
                        href={settings.socials.instagram}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="flex items-center justify-between text-xs text-gray-300 hover:text-amber-400 p-2 rounded-lg hover:bg-gray-800/50 transition"
                      >
                        <span className="flex items-center gap-2"><Instagram size={14} /> Instagram</span>
                        <ExternalLink size={12} />
                      </a>
                    )}
                    {settings.socials.tiktok && (
                      <a
                        href={settings.socials.tiktok}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="flex items-center justify-between text-xs text-gray-300 hover:text-amber-400 p-2 rounded-lg hover:bg-gray-800/50 transition"
                      >
                        <span className="flex items-center gap-2"><Music size={14} /> TikTok</span>
                        <ExternalLink size={12} />
                      </a>
                    )}
                    {settings.socials.youtube && (
                      <a
                        href={settings.socials.youtube}
                        target="_blank"
                        rel="noopener noreferrer"
                        className="flex items-center justify-between text-xs text-gray-300 hover:text-amber-400 p-2 rounded-lg hover:bg-gray-800/50 transition"
                      >
                        <span className="flex items-center gap-2"><Youtube size={14} /> YouTube</span>
                        <ExternalLink size={12} />
                      </a>
                    )}
                  </div>
                </div>
              </div>

              {/* Right Column: Web Inquiry Form */}
              <div className="md:col-span-3">
                <div className="bg-[#151C28] border border-gray-800 rounded-2xl p-6">
                  <h3 className="text-xl font-bold text-white mb-2">Send an Enquiry</h3>
                  <p className="text-xs text-gray-400 mb-6">Fill in the fields below and we'll reply to your verified email or phone.</p>

                  {formSent && (
                    <div className="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm flex items-center gap-3">
                      <CheckCircle size={18} />
                      <span>Thank you. Your inquiry has been sent to our desk!</span>
                    </div>
                  )}

                  <form onSubmit={handleContactSubmit} className="space-y-4">
                    <div>
                      <label className="block text-xs font-medium text-gray-300 mb-1">Your Full Name *</label>
                      <input
                        type="text"
                        required
                        value={contactForm.name}
                        onChange={(e) => setContactForm({ ...contactForm, name: e.target.value })}
                        placeholder="e.g. Marcus Reid"
                        className="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 transition"
                      />
                    </div>

                    <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                      <div>
                        <label className="block text-xs font-medium text-gray-300 mb-1">Email Address *</label>
                        <input
                          type="email"
                          required
                          value={contactForm.email}
                          onChange={(e) => setContactForm({ ...contactForm, email: e.target.value })}
                          placeholder="marcus@example.com"
                          className="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 transition"
                        />
                      </div>
                      <div>
                        <label className="block text-xs font-medium text-gray-300 mb-1">Phone / WhatsApp (Optional)</label>
                        <input
                          type="tel"
                          value={contactForm.phone}
                          onChange={(e) => setContactForm({ ...contactForm, phone: e.target.value })}
                          placeholder="+44 7000..."
                          className="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 transition"
                        />
                      </div>
                    </div>

                    <div>
                      <label className="block text-xs font-medium text-gray-300 mb-1">Service Required</label>
                      <select
                        value={contactForm.serviceCategory}
                        onChange={(e) => setContactForm({ ...contactForm, serviceCategory: e.target.value })}
                        className="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 transition"
                      >
                        <option value="General Inquiry">General Inquiry</option>
                        {services.map(s => (
                          <option key={s.id} value={s.title}>{s.title}</option>
                        ))}
                      </select>
                    </div>

                    <div>
                      <label className="block text-xs font-medium text-gray-300 mb-1">Project Details / Message *</label>
                      <textarea
                        required
                        rows={4}
                        value={contactForm.message}
                        onChange={(e) => setContactForm({ ...contactForm, message: e.target.value })}
                        placeholder="Tell us about your tracks, deadline, requirements..."
                        className="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500 transition"
                      />
                    </div>

                    <button
                      type="submit"
                      className="w-full py-3.5 bg-amber-500 hover:bg-amber-400 text-black font-bold rounded-xl transition flex items-center justify-center gap-2"
                    >
                      <Send size={16} /> Send Official Message
                    </button>
                  </form>
                </div>
              </div>
            </div>
          </section>
        )}

        {/* VIEW: SECURE ADMIN CONTROL PANEL */}
        {activeTab === 'admin' && (
          <section className="max-w-5xl mx-auto px-4 py-8">
            <div className="flex items-center justify-between mb-8">
              <div>
                <h1 className="text-3xl font-extrabold text-white uppercase tracking-tight flex items-center gap-2">
                  <Shield size={28} className="text-amber-500" /> Admin Studio Hub
                </h1>
                <p className="text-xs text-gray-400 mt-1">Manage all StreetTunes services, WhatsApp numbers, media, and leads.</p>
              </div>

              {isAdminAuthenticated && (
                <button
                  onClick={() => setIsAdminAuthenticated(false)}
                  className="px-3 py-1.5 border border-red-500/30 text-red-400 hover:bg-red-500/10 rounded-lg text-xs font-semibold"
                >
                  Log Out
                </button>
              )}
            </div>

            {!isAdminAuthenticated ? (
              <div className="max-w-md mx-auto bg-[#151C28] border border-gray-800 rounded-2xl p-6 text-center">
                <Shield size={40} className="text-amber-500 mx-auto mb-3" />
                <h3 className="text-lg font-bold text-white mb-2">Administrator Passcode Required</h3>
                <p className="text-xs text-gray-400 mb-6">Enter your security PIN to edit application details. (Default passcode: <span className="font-mono text-amber-400 font-bold">1234</span>)</p>
                <form
                  onSubmit={(e) => {
                    e.preventDefault();
                    if (adminPin === '1234') {
                      setIsAdminAuthenticated(true);
                      setAdminPin('');
                    } else {
                      alert('Incorrect Admin Passcode');
                    }
                  }}
                  className="space-y-4"
                >
                  <input
                    type="password"
                    maxLength={6}
                    value={adminPin}
                    onChange={(e) => setAdminPin(e.target.value)}
                    placeholder="Enter Passcode"
                    className="w-full text-center tracking-widest text-lg py-2.5 bg-gray-900 border border-gray-700 rounded-xl text-white focus:outline-none focus:border-amber-500"
                  />
                  <button
                    type="submit"
                    className="w-full py-3 bg-amber-500 hover:bg-amber-400 text-black font-bold rounded-xl text-sm"
                  >
                    Unlock Administration
                  </button>
                </form>
              </div>
            ) : (
              <div className="space-y-6">
                {/* Admin Subnav */}
                <div className="flex flex-wrap gap-2 border-b border-gray-800 pb-4">
                  {['dashboard', 'services', 'settings', 'leads'].map((view) => (
                    <button
                      key={view}
                      onClick={() => setAdminView(view)}
                      className={`capitalize px-4 py-2 rounded-xl text-xs font-semibold transition ${
                        adminView === view
                          ? 'bg-amber-500 text-black'
                          : 'bg-[#151C28] text-gray-400 hover:text-white'
                      }`}
                    >
                      {view}
                    </button>
                  ))}
                </div>

                {/* Subview: Dashboard Stats */}
                {adminView === 'dashboard' && (
                  <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div className="bg-[#151C28] border border-gray-800 p-5 rounded-xl">
                      <span className="text-xs text-gray-500 uppercase font-medium">Active Services</span>
                      <p className="text-3xl font-black text-white mt-1">{services.filter(s => s.active).length}</p>
                    </div>
                    <div className="bg-[#151C28] border border-gray-800 p-5 rounded-xl">
                      <span className="text-xs text-gray-500 uppercase font-medium">Inbox Enquiries</span>
                      <p className="text-3xl font-black text-white mt-1">{inquiries.length}</p>
                    </div>
                    <div className="bg-[#151C28] border border-gray-800 p-5 rounded-xl">
                      <span className="text-xs text-gray-500 uppercase font-medium">WhatsApp Configuration</span>
                      <p className="text-sm font-mono text-emerald-400 mt-2 truncate">+{settings.whatsAppNumber}</p>
                    </div>
                  </div>
                )}

                {/* Subview: Services Manager */}
                {adminView === 'services' && (
                  <div className="space-y-6">
                    <div className="flex justify-between items-center">
                      <h3 className="font-bold text-white text-lg">Services Configurator</h3>
                      <button
                        onClick={() => {
                          const newService = {
                            id: `srv-${Date.now()}`,
                            title: "New Audio Service",
                            category: "Production",
                            shortDesc: "Brief overview of this service.",
                            fullDesc: "Complete description and client workflow steps.",
                            priceNote: "Inquire for quote",
                            imageUrl: "https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?auto=format&fit=crop&w=800&q=80",
                            featured: false,
                            active: true
                          };
                          setServices([newService, ...services]);
                        }}
                        className="px-3 py-1.5 bg-amber-500 hover:bg-amber-400 text-black text-xs font-bold rounded-lg flex items-center gap-1.5"
                      >
                        <Plus size={14} /> Add Service
                      </button>
                    </div>

                    <div className="space-y-4">
                      {services.map((item) => (
                        <div key={item.id} className="bg-[#151C28] border border-gray-800 p-4 rounded-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
                          <div className="flex-1">
                            <span className="text-[10px] text-amber-500 font-bold uppercase tracking-wider">{item.category}</span>
                            <h4 className="text-white font-bold">{item.title}</h4>
                            <p className="text-xs text-gray-400">{item.priceNote}</p>
                          </div>
                          <div className="flex items-center gap-2">
                            <button
                              onClick={() => {
                                const newTitle = prompt('Service Title:', item.title) || item.title;
                                const newPrice = prompt('Price or Availability Note:', item.priceNote) || item.priceNote;
                                setServices(services.map(s => s.id === item.id ? { ...s, title: newTitle, priceNote: newPrice } : s));
                              }}
                              className="p-2 bg-gray-800 hover:bg-gray-700 text-gray-300 rounded-lg text-xs"
                              title="Edit"
                            >
                              <Edit3 size={14} />
                            </button>
                            <button
                              onClick={() => {
                                setServices(services.map(s => s.id === item.id ? { ...s, active: !s.active } : s));
                              }}
                              className={`px-2.5 py-1.5 rounded-lg text-xs font-semibold ${
                                item.active ? 'bg-emerald-500/20 text-emerald-400' : 'bg-red-500/20 text-red-400'
                              }`}
                            >
                              {item.active ? 'Active' : 'Hidden'}
                            </button>
                            <button
                              onClick={() => {
                                if (confirm(`Remove ${item.title}?`)) {
                                  setServices(services.filter(s => s.id !== item.id));
                                }
                              }}
                              className="p-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg"
                              title="Delete"
                            >
                              <Trash2 size={14} />
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* Subview: Settings & WhatsApp Config */}
                {adminView === 'settings' && (
                  <div className="bg-[#151C28] border border-gray-800 rounded-2xl p-6 space-y-4">
                    <h3 className="font-bold text-white text-lg mb-2">Business & Contact Settings</h3>
                    
                    <div>
                      <label className="block text-xs text-gray-400 mb-1">
                        Verified WhatsApp International Number (No plus sign, spaces, or brackets)
                      </label>
                      <input
                        type="text"
                        value={settings.whatsAppNumber}
                        onChange={(e) => setSettings({ ...settings, whatsAppNumber: e.target.value })}
                        placeholder="e.g. 447123456789"
                        className="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2 text-sm text-emerald-400 font-mono"
                      />
                      <span className="text-[11px] text-gray-500 mt-1 block">
                        Direct links will generate format: https://wa.me/{settings.whatsAppNumber}
                      </span>
                    </div>

                    <div>
                      <label className="block text-xs text-gray-400 mb-1">Official Email Address</label>
                      <input
                        type="email"
                        value={settings.email}
                        onChange={(e) => setSettings({ ...settings, email: e.target.value })}
                        className="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2 text-sm text-white"
                      />
                    </div>

                    <div>
                      <label className="block text-xs text-gray-400 mb-1">About Copy / Slogan</label>
                      <textarea
                        rows={3}
                        value={settings.aboutText}
                        onChange={(e) => setSettings({ ...settings, aboutText: e.target.value })}
                        className="w-full bg-gray-900 border border-gray-700 rounded-xl px-4 py-2 text-sm text-white"
                      />
                    </div>
                  </div>
                )}

                {/* Subview: Leads Inbox */}
                {adminView === 'leads' && (
                  <div className="space-y-4">
                    <h3 className="font-bold text-white text-lg">Client Submissions</h3>
                    {inquiries.length === 0 ? (
                      <p className="text-sm text-gray-500">No client submissions yet.</p>
                    ) : (
                      inquiries.map((inq) => (
                        <div key={inq.id} className="bg-[#151C28] border border-gray-800 p-4 rounded-xl">
                          <div className="flex justify-between items-start mb-2">
                            <div>
                              <h4 className="font-bold text-white">{inq.name}</h4>
                              <p className="text-xs text-gray-400">{inq.email} • {inq.phone || 'No phone provided'}</p>
                            </div>
                            <span className="text-[10px] text-gray-500">{inq.timestamp}</span>
                          </div>
                          <div className="p-3 bg-gray-900/60 rounded-lg text-xs text-gray-300 mb-3">
                            <span className="text-amber-400 font-semibold block mb-1">Service: {inq.serviceCategory}</span>
                            {inq.message}
                          </div>
                          <div className="flex justify-end gap-2">
                            <button
                              onClick={() => setInquiries(inquiries.filter(i => i.id !== inq.id))}
                              className="text-xs text-red-400 hover:text-red-300"
                            >
                              Delete
                            </button>
                          </div>
                        </div>
                      ))
                    )}
                  </div>
                )}
              </div>
            )}
          </section>
        )}
      </main>

      {/* --- FLOATING WHATSAPP CTA --- */}
      <aside aria-label="Quick WhatsApp Contact" className="fixed bottom-20 md:bottom-8 right-5 z-40">
        <a
          href={getWhatsAppUrl("Hi StreetTunes, I have a quick enquiry about booking a session.")}
          target="_blank"
          rel="noopener noreferrer"
          className="flex items-center gap-2.5 bg-[#25D366] hover:bg-[#20ba59] text-black font-bold px-4 py-3 rounded-full shadow-2xl transition hover:scale-105 active:scale-95 group"
          title="Direct WhatsApp Us"
        >
          <MessageSquare size={20} className="fill-black" />
          <span className="text-xs tracking-tight hidden sm:inline">WhatsApp Us</span>
        </a>
      </aside>

      {/* --- MOBILE THUMB-FRIENDLY BOTTOM NAVIGATION --- */}
      <nav aria-label="Mobile Navigation" className="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-[#0B0F17]/95 backdrop-blur-lg border-t border-gray-800 px-3 py-2 flex justify-around">
        {[
          { tab: 'home', label: 'Home', icon: Music },
          { tab: 'services', label: 'Services', icon: Play },
          { tab: 'media', label: 'Gallery', icon: ImageIcon },
          { tab: 'contact', label: 'Contact', icon: Phone },
        ].map(({ tab, label, icon: Icon }) => (
          <button
            key={tab}
            onClick={() => { setActiveTab(tab); setSelectedService(null); }}
            className={`flex flex-col items-center gap-1 text-[10px] font-medium py-1 px-3 rounded-lg transition ${
              activeTab === tab ? 'text-amber-400' : 'text-gray-400 hover:text-gray-200'
            }`}
          >
            <Icon size={18} />
            <span>{label}</span>
          </button>
        ))}
      </nav>

      {/* --- BUSINESS FOOTER --- */}
      <footer className="bg-[#080B11] border-t border-gray-800/80 px-4 py-12 text-xs text-gray-400">
        <div className="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
          <div className="space-y-3">
            <span className="text-base font-bold text-white tracking-tight">{settings.businessName}</span>
            <p className="text-gray-400 leading-relaxed">{settings.tagline}</p>
            <p className="text-gray-500 text-[11px]">UK-based production & sound house.</p>
          </div>

          <div>
            <h5 className="font-semibold text-white uppercase tracking-wider text-[11px] mb-3">Service Sectors</h5>
            <ul className="space-y-2">
              {services.slice(0, 4).map(s => (
                <li key={s.id}>
                  <button 
                    onClick={() => { setSelectedService(s); setActiveTab('services'); }}
                    className="hover:text-amber-400 transition"
                  >
                    {s.title}
                  </button>
                </li>
              ))}
            </ul>
          </div>

          <div>
            <h5 className="font-semibold text-white uppercase tracking-wider text-[11px] mb-3">Verified Contact</h5>
            <ul className="space-y-2">
              <li>WhatsApp: +{settings.whatsAppNumber}</li>
              <li>Email: {settings.email}</li>
              <li>Location: {settings.location}</li>
            </ul>
          </div>

          <div>
            <h5 className="font-semibold text-white uppercase tracking-wider text-[11px] mb-3">Legal & GDPR</h5>
            <p className="text-[11px] text-gray-500 mb-2">Compliant with UK Data Protection and GDPR standard guidelines for inquiries.</p>
            <div className="flex gap-3 text-[11px]">
              <span className="hover:underline cursor-pointer">Privacy Notice</span>
              <span>•</span>
              <span className="hover:underline cursor-pointer">Terms of Service</span>
            </div>
          </div>
        </div>

        <div className="max-w-6xl mx-auto pt-6 border-t border-gray-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
          <p>© {new Date().getFullYear()} {settings.businessName}. All rights reserved.</p>
          <p className="text-gray-600 text-[11px]">Designed mobile-first. Connected directly to WhatsApp Business API standards.</p>
        </div>
      </footer>

    </div>
  );
}
